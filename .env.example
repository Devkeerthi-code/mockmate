# Database connection string (PostgreSQL via Neon or standard PostgreSQL)
# Example: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/mockmate?schema=public"

# Gemini API Key for driving the interviewer and generating rubric reports
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# JWT Secret for signing candidate session tokens (generate via `openssl rand -hex 32`)
JWT_SECRET="your-jwt-secret-key-at-least-32-chars-long"

# Comma-separated list of platform admin emails (for question bank editing)
ADMIN_EMAILS="admin@example.com,pdevkeerthi7@gmail.com"

# Public site URL (for redirects and metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
